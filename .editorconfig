root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
tab_width = 8

[*.json]
charset = utf-8
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

[*.nix]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.yaml]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true
